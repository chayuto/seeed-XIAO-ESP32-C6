# 03_csi_presence — room presence from Wi-Fi CSI. No secrets here: Wi-Fi creds go in
# sdkconfig.defaults.local (gitignored).
CONFIG_IDF_TARGET="esp32c6"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# agentic-logging
CONFIG_LOG_MAXIMUM_LEVEL_DEBUG=y
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_COLORS=n
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096

# 3 MB app + core dump slot (partitions.csv)
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Core dump to flash, ELF format: read back with .claude/skills/xiao-debug/scripts/coredump.sh
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y
CONFIG_ESP_COREDUMP_CHECKSUM_CRC32=y

# Channel state information from the Wi-Fi driver (off by default)
CONFIG_ESP_WIFI_CSI_ENABLED=y

# Console on the USB port only. The IDF default is UART0 at 115200 with USB as a copy, and
# every line waits for the UART (~11.5 KB/s): the raw dump blocked the CSI task, starved the
# ping task and cut the frame rate from ~55/s to ~18/s (2026-09-29).
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
