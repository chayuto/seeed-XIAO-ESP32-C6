# Copy to .env (gitignored). Same Supabase project as the Govee monitor: take the values
# from ws-ESP32-C6-Touch-AMOLED-1.8/projects/18_govee_monitor/.env.

SUPABASE_URL=https://<ref>.supabase.co

# Firmware key: INSERT-only by RLS. Also goes into sdkconfig.defaults.local.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Host only - full REST access. Never in firmware.
SUPABASE_SECRET_KEY=sb_secret_...

# DDL only. SESSION POOLER string (port 5432); db.<ref>.supabase.co is IPv6-only and
# unreachable from this Mac. Username is postgres.<ref>.
DATABASE_URL=postgresql://postgres.<ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Optional: the Govee dashboard's JWT, so verify.sh can prove it sees nothing here.
DASHBOARD_JWT=
