# 02_airpurifier_coap — read a Philips air purifier over local CoAP.
# No secrets or home-network details here: Wi-Fi creds and CONFIG_PURIFIER_HOST go in
# sdkconfig.defaults.local (gitignored).
CONFIG_IDF_TARGET="esp32c6"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# 3 MB app + core dump slot (partitions.csv, same as 01_bringup)
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y
CONFIG_ESP_COREDUMP_CHECKSUM_CRC32=y

# The status reply is one ~2.1 KB UDP datagram, IP-fragmented on the way in.
CONFIG_LWIP_IP4_REASSEMBLY=y

# Uploads (TLS) run in their own 8 KB task (uploader.c). Main keeps some headroom for
# cJSON and the logs; 3.5 KB was never measured against this loop.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144

# Recovery: the main loop and the uploader feed the task watchdog; 60 s without a feed
# means a hang, and the panic reboots the board (core dump kept for coredump.sh).
# 60 is the Kconfig maximum: 90 was silently replaced by the default 5, which would have
# rebooted the board on the first 12 s sync.
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_INIT=y
CONFIG_ESP_TASK_WDT_PANIC=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=60

# agentic-logging
CONFIG_LOG_MAXIMUM_LEVEL_DEBUG=y
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_COLORS=n
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
